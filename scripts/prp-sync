#!/bin/bash
# prp-sync - Manage methodology subtree in projects
#
# Usage:
#   prp-sync init                  Initialize methodology in project
#   prp-sync pull                  Pull methodology updates
#   prp-sync push                  Push methodology improvements
#   prp-sync wire                  Wire Claude Code components
#   prp-sync status                Show current status

set -e

# Configuration - customize these for your setup
METHOD_REMOTE="prp-method"
METHOD_URL="${PRP_METHODOLOGY_URL:-git@github.com:yourorg/prp-methodology.git}"
METHOD_PREFIX=".prp"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Ensure remote exists
ensure_remote() {
    local name=$1
    local url=$2
    if ! git remote get-url "$name" &>/dev/null; then
        echo "Adding remote $name → $url"
        git remote add "$name" "$url"
    fi
}

# Commands
cmd_init() {
    echo -e "${YELLOW}Initializing PRP methodology...${NC}"

    if [ -d "$METHOD_PREFIX" ]; then
        echo -e "${RED}Error: $METHOD_PREFIX already exists${NC}"
        echo "Use 'prp-sync pull' to update, or remove $METHOD_PREFIX first"
        exit 1
    fi

    ensure_remote "$METHOD_REMOTE" "$METHOD_URL"

    echo "Adding subtree from $METHOD_URL..."
    git subtree add --prefix="$METHOD_PREFIX" "$METHOD_REMOTE" main --squash

    echo ""
    echo -e "${GREEN}✓ Methodology initialized${NC}"
    echo ""
    echo "Next steps:"
    echo "  prp-sync wire    # Wire Claude Code components"
    echo "  mkdir -p features"
    echo "  cp $METHOD_PREFIX/templates/progress.template.txt features/progress.txt"
}

cmd_pull() {
    echo -e "${YELLOW}Pulling methodology updates...${NC}"

    ensure_remote "$METHOD_REMOTE" "$METHOD_URL"

    if [ ! -d "$METHOD_PREFIX" ]; then
        echo -e "${RED}Error: $METHOD_PREFIX not found${NC}"
        echo "Run 'prp-sync init' first"
        exit 1
    fi

    # Show what will change
    echo "Fetching changes..."
    git fetch "$METHOD_REMOTE"

    echo ""
    echo "Changes:"
    git diff "$METHOD_PREFIX" "$METHOD_REMOTE/main" --stat 2>/dev/null || echo "(Unable to show diff)"
    echo ""

    read -p "Pull these changes? [y/N] " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        git subtree pull --prefix="$METHOD_PREFIX" "$METHOD_REMOTE" main --squash
        echo -e "${GREEN}✓ Methodology updated${NC}"
    else
        echo "Cancelled"
    fi
}

cmd_push() {
    echo -e "${YELLOW}Pushing methodology improvements...${NC}"

    ensure_remote "$METHOD_REMOTE" "$METHOD_URL"

    if [ ! -d "$METHOD_PREFIX" ]; then
        echo -e "${RED}Error: $METHOD_PREFIX not found${NC}"
        exit 1
    fi

    echo "This will push your changes in $METHOD_PREFIX to $METHOD_URL"
    echo ""
    echo "Changed files in $METHOD_PREFIX:"
    git diff HEAD --name-only -- "$METHOD_PREFIX/" || echo "(No uncommitted changes)"
    echo ""

    read -p "Push these improvements? [y/N] " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        git subtree push --prefix="$METHOD_PREFIX" "$METHOD_REMOTE" main
        echo -e "${GREEN}✓ Improvements pushed${NC}"
    else
        echo "Cancelled"
    fi
}

cmd_wire() {
    echo -e "${YELLOW}Wiring Claude Code components...${NC}"

    if [ ! -d "$METHOD_PREFIX" ]; then
        echo -e "${RED}Error: $METHOD_PREFIX not found${NC}"
        echo "Run 'prp-sync init' first"
        exit 1
    fi

    mkdir -p .claude

    # Wire commands
    if [ -L ".claude/commands" ]; then
        echo "Commands: already symlinked"
    elif [ -d ".claude/commands" ]; then
        echo -e "${YELLOW}Commands: directory exists (not symlinked)${NC}"
        read -p "Replace with symlink? [y/N] " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            rm -rf .claude/commands
            ln -s "../$METHOD_PREFIX/commands" .claude/commands
            echo -e "${GREEN}✓ Commands symlinked${NC}"
        fi
    else
        ln -s "../$METHOD_PREFIX/commands" .claude/commands
        echo -e "${GREEN}✓ Commands symlinked${NC}"
    fi

    # Wire agents
    if [ -d "$METHOD_PREFIX/agents" ]; then
        if [ -L ".claude/agents" ]; then
            echo "Agents: already symlinked"
        elif [ -d ".claude/agents" ]; then
            echo -e "${YELLOW}Agents: directory exists (not symlinked)${NC}"
        else
            ln -s "../$METHOD_PREFIX/agents" .claude/agents
            echo -e "${GREEN}✓ Agents symlinked${NC}"
        fi
    fi

    # Wire skills
    if [ -d "$METHOD_PREFIX/skills" ]; then
        if [ -L ".claude/skills" ]; then
            echo "Skills: already symlinked"
        elif [ -d ".claude/skills" ]; then
            echo -e "${YELLOW}Skills: directory exists (not symlinked)${NC}"
            echo "Consider merging methodology skills with project skills"
        else
            ln -s "../$METHOD_PREFIX/skills" .claude/skills
            echo -e "${GREEN}✓ Skills symlinked${NC}"
        fi
    fi

    echo ""
    echo -e "${GREEN}✓ Claude Code wired${NC}"
    echo ""
    echo "Components now available:"
    ls -la .claude/
}

cmd_status() {
    echo -e "${YELLOW}PRP Methodology Status${NC}"
    echo ""

    if [ -d "$METHOD_PREFIX" ]; then
        echo "Methodology: $METHOD_PREFIX"
        if [ -f "$METHOD_PREFIX/VERSION" ]; then
            echo "  Version: $(cat $METHOD_PREFIX/VERSION)"
        fi
        if git remote get-url "$METHOD_REMOTE" &>/dev/null; then
            echo "  Remote: $(git remote get-url $METHOD_REMOTE)"
        fi
    else
        echo "Methodology: not initialized"
        echo "  Run 'prp-sync init' to add methodology"
    fi

    echo ""
    echo "Claude Code wiring:"

    for component in commands agents skills; do
        if [ -L ".claude/$component" ]; then
            target=$(readlink ".claude/$component")
            echo "  $component: symlink → $target"
        elif [ -d ".claude/$component" ]; then
            echo "  $component: directory (not symlinked)"
        else
            echo "  $component: not configured"
        fi
    done

    echo ""
    echo "Features:"
    if [ -d "features" ]; then
        echo "  Directory: features/"
        if [ -f "features/progress.txt" ]; then
            lines=$(wc -l < features/progress.txt)
            echo "  Progress: features/progress.txt ($lines lines)"
        fi
        if [ -f "features/current.json" ]; then
            echo "  Active: features/current.json"
        fi
    else
        echo "  Not initialized"
    fi
}

cmd_help() {
    echo "prp-sync - Manage PRP methodology in projects"
    echo ""
    echo "Usage: prp-sync <command>"
    echo ""
    echo "Commands:"
    echo "  init      Initialize methodology subtree in project"
    echo "  pull      Pull methodology updates from remote"
    echo "  push      Push methodology improvements to remote"
    echo "  wire      Wire/symlink Claude Code components"
    echo "  status    Show current status"
    echo "  help      Show this help"
    echo ""
    echo "Environment:"
    echo "  PRP_METHODOLOGY_URL  Override default methodology repo URL"
}

# Main
case "${1:-help}" in
    init)   cmd_init ;;
    pull)   cmd_pull ;;
    push)   cmd_push ;;
    wire)   cmd_wire ;;
    status) cmd_status ;;
    help)   cmd_help ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        cmd_help
        exit 1
        ;;
esac
